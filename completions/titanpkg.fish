# Fish shell completions for titanpkg (ArchTitan OS)
complete -c titanpkg -f

# Arch pacman-style flags
complete -c titanpkg -o Syu -d "Synchronize repositories and upgrade all Titan subsystems"
complete -c titanpkg -o S   -d "Install or reinstall Titan packages"
complete -c titanpkg -o Sy  -d "Synchronize Titan repository databases"
complete -c titanpkg -o Su  -d "Upgrade installed Titan subsystems"
complete -c titanpkg -o Ss  -d "Search repositories for matching packages"
complete -c titanpkg -o Si  -d "Display repository package information"
complete -c titanpkg -o Sl  -d "List all available packages in repositories"
complete -c titanpkg -o Sc  -d "Clean old cached packages"
complete -c titanpkg -o Scc -d "Clean all cached packages and indexes"
complete -c titanpkg -o R   -d "Remove installed packages"
complete -c titanpkg -o Rs  -d "Remove packages and orphaned dependencies"
complete -c titanpkg -o Rns -d "Remove packages, orphans, and skip .pacsave"
complete -c titanpkg -o Q   -d "List installed packages"
complete -c titanpkg -o Qu  -d "List upgradable packages"
complete -c titanpkg -o Qi  -d "Display installed package information"
complete -c titanpkg -o Ql  -d "List files owned by an installed package"
complete -c titanpkg -o Qo  -d "Query which Titan package owns a file"
complete -c titanpkg -o Qk  -d "Verify installed files against SHA-256 hashes"
complete -c titanpkg -o Qdt -d "List orphaned dependency packages"
complete -c titanpkg -s V -l version -d "Show version"

# Global options
complete -c titanpkg -l root       -r -d "Operate on a sandbox root"
complete -c titanpkg -l config     -r -d "Override path to titanpkg.json"
complete -c titanpkg -s y -l noconfirm -d "Assume yes for all prompts"
complete -c titanpkg -l needed        -d "Do not reinstall up-to-date targets"
complete -c titanpkg -s p -l dry-run  -d "Print resolved plan and exit"
complete -c titanpkg -l offline       -d "Use cached indexes and packages only"
complete -c titanpkg -l json          -d "Emit machine-readable JSON output"
complete -c titanpkg -s v -l verbose  -d "Increase output verbosity"

# Subcommands
complete -c titanpkg -n "__fish_use_subcommand" -a update     -d "Refresh repository indexes (-Sy)"
complete -c titanpkg -n "__fish_use_subcommand" -a upgrade    -d "Upgrade installed packages (-Su / -Syu)"
complete -c titanpkg -n "__fish_use_subcommand" -a install    -d "Install packages (-S)"
complete -c titanpkg -n "__fish_use_subcommand" -a reinstall  -d "Reinstall installed packages"
complete -c titanpkg -n "__fish_use_subcommand" -a remove     -d "Remove installed packages (-R)"
complete -c titanpkg -n "__fish_use_subcommand" -a autoremove -d "Remove orphaned dependencies (-Qdt)"
complete -c titanpkg -n "__fish_use_subcommand" -a list       -d "List packages (-Q / -Sl / -Qu)"
complete -c titanpkg -n "__fish_use_subcommand" -a search     -d "Search repositories (-Ss)"
complete -c titanpkg -n "__fish_use_subcommand" -a info       -d "Show package metadata (-Si / -Qi)"
complete -c titanpkg -n "__fish_use_subcommand" -a files      -d "List package files (-Ql)"
complete -c titanpkg -n "__fish_use_subcommand" -a owns       -d "Query file owner (-Qo)"
complete -c titanpkg -n "__fish_use_subcommand" -a verify     -d "Verify installed files (-Qk)"
complete -c titanpkg -n "__fish_use_subcommand" -a rollback   -d "Roll back a package to an older version"
complete -c titanpkg -n "__fish_use_subcommand" -a clean      -d "Prune cached packages (-Sc)"
complete -c titanpkg -n "__fish_use_subcommand" -a doctor     -d "Run security and config diagnostics"
complete -c titanpkg -n "__fish_use_subcommand" -a key        -d "Manage trusted repository GPG keys"
complete -c titanpkg -n "__fish_use_subcommand" -a self-check -d "Verify titanpkg modules"
