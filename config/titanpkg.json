{
  "db": "/var/lib/titanpkg",
  "cache": "/var/cache/titanpkg",
  "config_dir": "/etc/titanpkg",
  "repos_dir": "/etc/titanpkg/repos.d",
  "keyring": "/etc/titanpkg/trusted.gpg",
  "siglevel": "required",
  "timeout": 30,
  "allowed_prefixes": [
    "usr/local/",
    "usr/lib/qt6/qml/ArchTitan/",
    "usr/lib/archtitan/",
    "usr/lib/libTitanUI.so/",
    "usr/include/archtitan/",
    "usr/share/archtitan/",
    "usr/share/applications/",
    "usr/share/icons/hicolor/",
    "etc/archtitan/",
    "etc/titanpkg/",
    "etc/titan-hwm/",
    "etc/titan-sandbox/",
    "etc/skel/",
    "etc/systemd/system/",
    "var/lib/archtitan/",
    "opt/archtitan/"
  ],
  "protected_packages": [
    "titan-hwm",
    "titanpkg",
    "archtitan-guard",
    "titan-ui"
  ]
}
